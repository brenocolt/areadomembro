{
  "aba": "Reconhecimentos e Bonificações",
  "origem": {
    "sistema": "[VP] Acompanhamento Fin",
    "stack": "React 18 + Vite + TypeScript + shadcn/ui + Tailwind + TanStack Query + Supabase (PostgreSQL)",
    "rota": "/reconhecimentos",
    "item_de_menu": "Reconhecimentos e Bonificações (ícone Award, grupo principal da sidebar)"
  },
  "bancos": [
    {
      "nome": "reconhecimento_tipos",
      "papel": "Catálogo de tipos de reconhecimento",
      "campos": {
        "nome": "texto", "escopo": "seleção: projeto | pessoa", "ativo": "checkbox", "ordem": "número"
      },
      "relacoes": ["1 tipo → N regras_bonificacao", "1 tipo → N reconhecimentos"]
    },
    {
      "nome": "regras_bonificacao",
      "papel": "Define quando e quanto bonificar",
      "campos": {
        "nome": "texto",
        "tipo_id": "relação → reconhecimento_tipos",
        "criterio": "seleção: por_reconhecimento | acumulado | simbolico",
        "quantidade_necessaria": "número (marco inicial; só acumulado)",
        "ciclo": "número (0 = não repete)",
        "requer_adiantado": "checkbox (no banco: requer_rg_adiantada; requer_projeto_adiantado é legado)",
        "tipo_premiacao": "seleção: financeira | premio | simbolica",
        "valor": "número (R$)",
        "descricao_premiacao": "texto",
        "prazo_dias": "número opcional",
        "ativo": "checkbox",
        "ordem": "número"
      }
    },
    {
      "nome": "reconhecimentos",
      "papel": "Registro dos reconhecimentos concedidos (entrada de dados do usuário)",
      "campos": {
        "tipo_id": "relação → reconhecimento_tipos",
        "data": "data",
        "projeto_id": "referência (sem FK) a centro_custo_entradas.id",
        "projeto_nome": "texto (snapshot)",
        "pessoa_nome": "texto (para Núcleo de Impacto guarda o nome do núcleo)",
        "adiantado": "checkbox",
        "nucleo_impacto": "seleção: Gestão de Pessoas | Presidência | Vice-Presidência | Marketing | CIT | CIEP | CS",
        "observacao": "texto longo",
        "criado_por": "texto (e-mail do usuário)"
      }
    },
    {
      "nome": "bonificacoes",
      "papel": "Bonificações geradas pelo motor (cartões do Kanban)",
      "campos": {
        "regra_id": "relação → regras_bonificacao",
        "reconhecimento_id": "relação → reconhecimentos (gatilho)",
        "marco_chave": "texto ÚNICO (idempotência)",
        "marco": "número",
        "projeto_id/projeto_nome/pessoa_nome/nucleo_impacto": "snapshots do sujeito",
        "tipo_nome/regra_nome/motivo": "snapshots textuais",
        "tipo_premiacao/valor/descricao_premiacao": "snapshot da premiação",
        "status": "seleção: disponivel | entregue | expirada | cancelada",
        "liberada_em": "data",
        "prazo_limite": "data",
        "entregue_em/entregue_por/entregue_para/observacao_entrega": "dados de entrega",
        "cancelada_em/cancelada_por/justificativa_cancelamento": "dados de cancelamento"
      }
    },
    {
      "nome": "bonificacao_eventos",
      "papel": "Trilha de auditoria por bonificação",
      "campos": {
        "bonificacao_id": "relação → bonificacoes",
        "evento": "criada | entregue | cancelada | expirada",
        "detalhe": "texto", "usuario": "texto", "created_at": "data/hora"
      }
    },
    {
      "nome": "bonificacoes_config",
      "papel": "Configuração global (1 linha)",
      "campos": { "prazo_padrao_dias": "número opcional" }
    }
  ],
  "relacoes": [
    "regras_bonificacao.tipo_id → reconhecimento_tipos.id (CASCADE)",
    "reconhecimentos.tipo_id → reconhecimento_tipos.id (CASCADE)",
    "bonificacoes.regra_id → regras_bonificacao.id (SET NULL)",
    "bonificacoes.reconhecimento_id → reconhecimentos.id (SET NULL)",
    "bonificacao_eventos.bonificacao_id → bonificacoes.id (CASCADE)",
    "reconhecimentos.projeto_id / bonificacoes.projeto_id → centros_custo_entradas.id (SEM FK; dado externo à aba)"
  ],
  "dependencias_externas_que_NAO_pertencem_a_aba": [
    "categorias_entradas e centros_custo_entradas (fonte da lista de projetos; usada também por Fluxo Mensal, Projeções de Entradas e Assembleia)",
    "projetos_entradas (tabela original de projetos; FK removida)",
    "função update_updated_at_column()",
    "components/ui/searchable-select.tsx (usado também por Fluxo Mensal)",
    "lib/formatters.ts (formatCurrency, formatDate pt-BR)",
    "login por e-mail (localStorage app_user_email) → define criado_por / entregue_por / cancelada_por"
  ],
  "abas_internas": ["Visão Geral", "Registrar", "Bonificações (Kanban)", "Histórico (linha do tempo)", "Configurações"],
  "filtros_globais": [
    {"id": "busca", "tipo": "texto, sem acento/caixa", "campos_pesquisados_bonificacoes": ["projeto_nome","pessoa_nome","tipo_nome","regra_nome","motivo"], "campos_pesquisados_reconhecimentos": ["projeto_nome","pessoa_nome","tipo"]},
    {"id": "de", "tipo": "data", "campo": "liberada_em (bonificações) / data (reconhecimentos), >="},
    {"id": "ate", "tipo": "data", "campo": "liberada_em / data, <="},
    {"id": "projeto_pessoa", "tipo": "seleção", "valor": "projeto:<id> ou pessoa:<nome>"},
    {"id": "nucleo", "tipo": "seleção dinâmica (valores presentes nos dados)"},
    {"id": "tipo", "tipo": "seleção por nome do tipo"},
    {"id": "status", "tipo": "seleção; exibido nas abas Visão Geral, Bonificações e Histórico; afeta apenas as bonificações (não os reconhecimentos). A aba Registrar não tem filtros"}
  ],
  "ordenacoes": {
    "bonificacoes": "liberada_em desc",
    "reconhecimentos": "data desc",
    "regras": "ordem asc",
    "tipos": "ordem asc",
    "eventos": "created_at asc",
    "linha_do_tempo": "grupos por nome (pt-BR asc); itens por data asc"
  },
  "formulas": [
    {"nome": "chave_do_sujeito", "formula": "projeto_id || projeto_nome || pessoa_nome || 'sem-identificacao'"},
    {"nome": "elegivel", "formula": "!(regra.requer_rg_adiantada || regra.requer_projeto_adiantado) || rec.adiantado || rec.rg_adiantada || rec.projeto_adiantado"},
    {"nome": "marcos_acumulado", "formula": "m = q, q+c, q+2c, ... enquanto m <= total_elegiveis_do_sujeito (c=0 → apenas m=q); q = max(1, quantidade_necessaria)"},
    {"nome": "marco_chave_por_reconhecimento", "formula": "<regra.id>:rec:<reconhecimento.id>"},
    {"nome": "marco_chave_acumulado", "formula": "<regra.id>:<chave_do_sujeito>:<m>"},
    {"nome": "liberada_em", "formula": "por_reconhecimento: rec.data; acumulado: data do m-ésimo reconhecimento (ordenado por data asc)"},
    {"nome": "prazo_limite", "formula": "dias = regra.prazo_dias ?? config.prazo_padrao_dias; dias truthy ? liberada_em + dias : null"},
    {"nome": "dias_restantes", "formula": "round((prazo_limite - hoje) / 86400000) em dias; null se sem prazo"},
    {"nome": "alerta_vencimento", "formula": "status = disponivel AND dias_restantes <= 7"},
    {"nome": "expirar", "formula": "status = disponivel AND prazo_limite < hoje (data ISO) → status = expirada"},
    {"nome": "motivo_acumulado", "formula": "`${m} reconhecimentos adiantados` se a regra exige adiantado, senão `${m} reconhecimentos`"},
    {"nome": "motivo_por_reconhecimento", "formula": "regra.nome"},
    {"nome": "rotulo_do_cartao_kanban", "formula": "projeto_id && marco ? `${marco}º reconhecimento` + (motivo contém 'adiantad' ? ' adiantado' : '') : tipo_nome"},
    {"nome": "cards_visao_geral", "formula": "Liberadas no mês = bonificações filtradas com liberada_em no mês atual (UTC); Disponíveis/Entregues = contagem por status; Canceladas/expiradas = status cancelada OU expirada"}
  ]
}
